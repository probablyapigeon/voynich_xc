continuous_wheel = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
reset_wheel      = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
baseline         = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)

for overlap, is_gallows, length in transitions:
    step = Ψ(c=overlap, p=0.9 if is_gallows else 0.1, r=length, s=overlap, Φ=0.7, 𝒯=0.5, E=length, d=0.2, a=0.5)
    
    # Agent 1: Never resets
    τᵢⱼ(continuous_wheel, step, weight=0.35, type='continuous')
    continuous_wheel = Ouroboros(continuous_wheel, target=step)
    
    # Agent 2: Resets cipher state whenever a Gallows character fires
    if is_gallows == 1:
        reset_wheel = Ouroboros(reset_wheel, target=baseline)
    τᵢⱼ(reset_wheel, step, weight=0.35, type='gallows_reset')
    reset_wheel = Ouroboros(reset_wheel, target=step)

print('1. Continuous Wheel (No Reset):')
print(continuous_wheel)
print('2. Gallows-Reset Wheel (Resets on K/T/P/F):')
print(reset_wheel)
