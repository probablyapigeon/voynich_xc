for tf in ['58v', '66r']:
    d = folio_data[tf]
    agent = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
    for c_val, s_val, e_val in d['obs']:
        tok = Ψ(c=c_val, p=0.5, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)
        τᵢⱼ(agent, tok, weight=0.3, type='proto_recipe_page')
        agent = Ouroboros(agent, target=tok)

    print('\n============================================================')
    print('FOLIO:', tf, '| Lines:', d['total_lines'], '| Tokens:', d['total_tokens'], '| Recipe Lexicon Overlap:', d['recipe_overlap_pct'], '%')
    print('XEMBRA PAGE STATE:', agent)
    print('Top 12 Words:', d['top_vocab'])
    print('  [1. MATCHED RECIPE OPENERS]:', d['openers'])
    print('  [2. TOP VERIFIED 3-WAY INGREDIENTS]:', d['ingredients_3way'])
    print('  [3. MATCHED PROCEDURAL ACTIONS]:', d['actions'])
    print('  [4. MATCHED RECIPE CLOSERS]:', d['closers'])
    print('  --- FIRST 8 LINES ---')
    for tag, tcnt, txt in d['head_lines']:
        print('   ', tag, '|', txt)
    print('  --- LAST 6 LINES ---')
    for tag, tcnt, txt in d['tail_lines']:
        print('   ', tag, '|', txt)
