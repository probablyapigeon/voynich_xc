def evolve_recipe(obs_list, label):
    agent = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
    for c_val, s_val, e_val in obs_list:
        tok = Ψ(c=c_val, p=0.5, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)
        τᵢⱼ(agent, tok, weight=0.3, type=label)
        agent = Ouroboros(agent, target=tok)
    return agent

print('=== CROSS-SECTION STARRED RECIPE RECONSTRUCTION (CARDS #33, #316, #325) ===')
for cid, fol, annot_text, ingredients, obs in reconstructions:
    st = evolve_recipe(obs, 'recipe_recon')
    print('\n------------------------------------------------------------------------')
    print('RECIPE CARD #', cid, '| FOLIO:', fol)
    print('Converged XEMBRA State :', st)
    print('Annotated Text         :', annot_text)
    print('Verified Master Lexicon Ingredients:')
    for w, cls_name, hits, jars, herbs, cosmo in ingredients:
        print('  *', w, '(', cls_name, '| Corpus Hits:', hits, ')')
        print('      -> Pharma Jar(s) :', jars)
        print('      -> Herbal Source :', herbs, '| Cosmo/Rosettes:', cosmo)
