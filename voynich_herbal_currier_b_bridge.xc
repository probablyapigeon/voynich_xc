print('=== 1. HERBAL-TO-RECIPE CURRIER-B BRIDGE COVERAGE (1r-66v) ===')
print('Total Herbal Folios:', total_herbal_folios, '| Folios Sharing 4o- Recipe Tokens:', bridged_herbal_folios)

print('\n=== 2. TOP 20 HERBAL FOLIOS BY 4o- RECIPE VOCABULARY OVERLAP ===')
for all_cnt, h56_cnt, dens, folio, tcnt, u56, uall, obs in top_20_folios:
    agent = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
    for c_val, s_val, e_val in obs:
        tok = Ψ(c=c_val, p=0.5, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)
        τᵢⱼ(agent, tok, weight=0.3, type='herbal_currier_b')
        agent = Ouroboros(agent, target=tok)
    print('FOLIO:', folio, '| 4o- Recipe Hits:', all_cnt, '| 56v-Set Hits:', h56_cnt, '| Density:', dens, '% (', tcnt, 'toks )')
    print('   56v-Set Matches:', u56, '| Sample 4o- Recipe Tokens:', uall)
    print('   State:', agent)
