def score_card(obs):
    agent = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
    for c_val, s_val, e_val in obs:
        tok = Ψ(c=c_val, p=0.5, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)
        τᵢⱼ(agent, tok, weight=0.3, type='recipe_card')
        agent = Ouroboros(agent, target=tok)
    return agent

print('=== VOYNICH STARRED RECIPE CARDS (103r-116v) ===')
print('Total Complete Starred Recipe Paragraphs Extracted:', total_cards)
print('Showing First 35 Segmented Recipe Cards:\n')

for header, opener, ing_prep, actions, closer, obs in recipe_cards:
    print(header, '|', score_card(obs))
    print('   [1. OPENER]          :', opener)
    print('   [2. INGREDIENT/PREP] :', ing_prep)
    print('   [3. ACTION]          :', actions)
    print('   [4. CLOSER]          :', closer)
