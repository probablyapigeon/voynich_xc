def evolve_seq(obs_list, label):
    agent = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
    for c_val, s_val, e_val in obs_list:
        tok = Ψ(c=c_val, p=0.5, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)
        τᵢⱼ(agent, tok, weight=0.3, type=label)
        agent = Ouroboros(agent, target=tok)
    return agent

print('=== 1. WITHIN-CARD STATE TRANSITION COUNTS (SAME ROOT, 103r-116v) ===')
print('Forward Transitions (RAW -> PREPARED -> ACTION):', fwd_total)
print('Reverse Transitions (ACTION -> PREPARED -> RAW):', rev_total)
for k, v in transitions.items():
    print('  ', k, ':', v)

print('\n=== 2. XEMBRA TRAJECTORY: FORWARD CHAINS VS REVERSE CHAINS ===')
print('Forward Chain State :', evolve_seq(forward_obs, 'fwd_chain'))
print('Reverse Chain State :', evolve_seq(reverse_obs, 'rev_chain'))

print('\n=== 3. COMPLETE 3-STAGE CARDS (ALL 3 ROLES OF SAME ROOT IN ONE RECIPE) ===')
print('Total Full 3-Stage Root Chains:', total_3stage, '| Strict Left-to-Right (RAW < PREPARED < ACTION):', strict_3stage)
for cid, folio, core, is_strict, chain_str, raw_txt in full_3stage_cards:
    print('Card', cid, '| Folio:', folio, '| Root:', core, '| Strict Order:', is_strict)
    print('   Chain:', chain_str)
    print('   Text :', raw_txt)
