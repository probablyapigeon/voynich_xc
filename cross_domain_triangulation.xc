psi_human   = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)

for c_val, s_val, e_val in v_obs:
    tok = Ψ(c=c_val, p=0.5, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)
    τᵢⱼ(psi_voynich, tok, weight=0.25, type='voynich_stream')
    psi_voynich = Ouroboros(psi_voynich, target=tok)

for c_val, s_val, e_val in f_obs:
    tok = Ψ(c=c_val, p=0.5, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)
    τᵢⱼ(psi_finch, tok, weight=0.25, type='finch_stream')
    psi_finch = Ouroboros(psi_finch, target=tok)

for c_val, s_val, e_val in h_obs:
    tok = Ψ(c=c_val, p=0.5, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)
    τᵢⱼ(psi_human, tok, weight=0.25, type='human_prose_stream')
    psi_human = Ouroboros(psi_human, target=tok)

# Cross-Domain Coupling Probes (Coupling Voynich directly against Avian vs Human Attractors)
voynich_x_finch = Ouroboros(psi_voynich, target=psi_finch)
τᵢⱼ(voynich_x_finch, psi_finch, weight=0.50, type='voynich_avian_resonance')

voynich_x_human = Ouroboros(psi_voynich, target=psi_human)
τᵢⱼ(voynich_x_human, psi_human, weight=0.50, type='voynich_human_resonance')

print('=== ISOLATED DOMAIN ATTRACTORS (450 TOKENS EACH) ===')
