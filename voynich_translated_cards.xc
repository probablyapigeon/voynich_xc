def score_recipe(obs):
    agent = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
    for c_val, s_val, e_val in obs:
        tok = Ψ(c=c_val, p=0.5, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)
        τᵢⱼ(agent, tok, weight=0.3, type='reconstructed_recipe')
        agent = Ouroboros(agent, target=tok)
    return agent

print('=== RECONSTRUCTED VOYNICH MULTI-INGREDIENT RECIPE CARDS ===\n')
for header, raw_seq, glossary, flow, obs in cards:
    print('====================================================================')
    print(header)
    print('XEMBRA Signature:', score_recipe(obs))
    print('ORIGINAL VOYNICH TEXT:', raw_seq)
    print('\n--- INGREDIENT PROVENANCE GLOSSARY ---')
    for word, form, h_fols, a_fols in glossary:
        print('  *', word, '|', form, '| Herbal:', h_fols, '| Apothecary:', a_fols)
    print('\n--- CLAUSE-BY-CLAUSE STRUCTURAL TRANSLATION ---')
    print(' ', flow)
    print()
