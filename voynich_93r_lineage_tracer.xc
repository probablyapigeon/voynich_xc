def evolve_lineage(obs_list, label):
    agent = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
    for c_val, s_val, e_val in obs_list:
        tok = Ψ(c=c_val, p=0.5, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)
        τᵢⱼ(agent, tok, weight=0.3, type=label)
        agent = Ouroboros(agent, target=tok)
    return agent

print('=== 1. XEMBRA LINEAGE CONSERVATION: FOLIO 93r JARS -> TARGET STARRED RECIPES ===')
print('Folio 93r Jar Lines (8 jars) :', evolve_lineage(jar_obs, 'jar_93r'))
print('Target Starred Recipes (7)   :', evolve_lineage(recipe_obs, 'target_recipes'))

