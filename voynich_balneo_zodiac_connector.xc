    print('  ', tok, '| Zodiac:', zcnt, '| Recipe:', rcnt, '| Zodiac Tags:', ztags, '| Cards:', rcards)

print('\n=== 4. STARRED RECIPES WITH HIGHEST 8- (LIQUID/BATH) PREFIX DENSITY ===')
for pct8, c8, tot, cid, fol, preview in top_8_cards:
