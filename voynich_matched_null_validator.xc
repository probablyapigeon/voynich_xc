def evolve_sample(obs_list, label):
    agent = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
    for c_val, s_val, e_val in obs_list:
        tok = Ψ(c=c_val, p=0.5, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)
        τᵢⱼ(agent, tok, weight=0.3, type=label)
        agent = Ouroboros(agent, target=tok)
    return agent

print('=== 1. STRATIFIED (LENGTH + FREQUENCY TIER) NULL BASELINE (1,000 PERMUTATIONS) ===')
print('Observed Jar -> Starred Recipe Matches           :', obs_rec_hits, 'out of', n_jars)
print('Matched Null Jar -> Recipe (Mean, SD, Z, p-val)  :', m_rec_stats)
print('Observed 3-Way Codex Bridges (Herbal+Jar+Rec)    :', obs_tri_hits, 'out of', n_jars)
print('Matched Null 3-Way Bridges (Mean, SD, Z, p-val)  :', m_tri_stats)

print('\n=== 2. XEMBRA STATE COMPARISON: REAL JARS VS LENGTH/FREQUENCY-MATCHED NULL ===')
print('Real Pharma Jar Vocabulary (238 tokens)          :', evolve_sample(jar_obs, 'real_jars'))
print('Matched Stratified Null Sample (238 tokens)      :', evolve_sample(null_obs, 'matched_null'))

print('\n=== 3. TOP 20 HIGH-SPECIFICITY 3-WAY BRIDGES (CONCENTRATED IN HERBAL + RECIPES) ===')
for share, hrc, tot, w, hc, rc in top_specific:
    print('  ', w, '| Herbal+Recipe Share:', share, '% (', hrc, '/', tot, ') | Herbal:', hc, '| Recipe:', rc)
