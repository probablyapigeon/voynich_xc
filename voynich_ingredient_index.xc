def score_ing(c_val, s_val, e_val, h_cnt, a_cnt, r_cnt):
    agent = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
    tok_h = Ψ(c=c_val, p=0.7, r=e_val, s=s_val, Φ=0.7, 𝒯=0.5, E=e_val, d=0.2, a=0.6)
    tok_a = Ψ(c=c_val, p=0.8, r=e_val, s=s_val, Φ=0.8, 𝒯=0.6, E=e_val, d=0.2, a=0.7)
    tok_r = Ψ(c=c_val, p=0.9, r=e_val, s=s_val, Φ=0.9, 𝒯=0.7, E=e_val, d=0.2, a=0.8)
    τᵢⱼ(agent, tok_h, weight=0.35, type='herbal_source')
    agent = Ouroboros(agent, target=tok_h)
    τᵢⱼ(agent, tok_a, weight=0.40, type='apothecary_jar')
    agent = Ouroboros(agent, target=tok_a)
    τᵢⱼ(agent, tok_r, weight=0.45, type='starred_recipe')
    agent = Ouroboros(agent, target=tok_r)
    return agent

print('=== VOYNICH INGREDIENT-TO-RECIPE CROSS-REFERENCE INDEX ===')
print('Total 3-Way Matched Ingredients (Herbal + Apothecary + Recipes):', total_tri_matches)
print('Showing Top 25 Cross-Section Ingredients:\n')

for score, lbl_hits, word, h_cnt, h_ex, a_cnt, a_ex, r_cnt, r_ex, feats in top_ingredients:
    c_val, s_val, e_val = feats
    print('INGREDIENT:', word, '| Label Hits:', lbl_hits, '|', score_ing(c_val, s_val, e_val, h_cnt, a_cnt, r_cnt))
    print('   [1. HERBAL PLANTS (1r-66v)]   :', h_cnt, 'hits ->', h_ex)
    print('   [2. APOTHECARY JARS (87r-102v)]:', a_cnt, 'hits ->', a_ex)
    print('   [3. RECIPE CARDS (103r-116v)] :', r_cnt, 'cards ->', r_ex)
