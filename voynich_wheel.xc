for overlap, has_gallows, length in transitions:
    step = Ψ(c=overlap, p=has_gallows, r=length, s=overlap, Φ=0.7, 𝒯=0.5, E=length, d=0.2, a=has_gallows)
    τᵢⱼ(wheel, step, weight=0.35, type='cipher_step')
    wheel = Ouroboros(wheel, target=step)
    if has_gallows > 0.5:
        gallows_hits = gallows_hits + 1

print('Gallows beacon triggers in first 1000 words:', gallows_hits)
print('Final Cipher-Wheel State:')
print(wheel)
