print('=== 1. TOP ILLUSTRATED PLANT FOLIOS (1r-66v) FEEDING STARRED RECIPES ===')
for rec_cnt, folio, toks, sample_recs in top_folios:
    print('Plant Folio:', folio, '| Recipes Fed:', rec_cnt, '| Key Compounds:', toks[:6], '| Sample:', sample_recs[:3])

print('\n=== 2. DIAGNOSTIC PLANT-SPECIFIC CANDIDATES (<=2 Plant Folios -> Specific Herb Names) ===')
diag_agent = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
for rec_cnt, tok, h_fols, a_fols, sample_recs in diagnostic_herbs:
    c_v = 0.9 if tok.startswith(('4o','8','2','o')) else 0.3
    s_v = 0.9 if tok.endswith(('9','am','ay','89')) else 0.3
    node = Ψ(c=c_v, p=0.25, r=0.85, s=s_v, Φ=0.9, 𝒯=0.8, E=0.75, d=0.1, a=0.9)
    τᵢⱼ(diag_agent, node, weight=0.25, type='diagnostic_herb')
    diag_agent = Ouroboros(diag_agent, target=node)
    print('  *', tok, '| Recipes:', rec_cnt, '| Plant Folio(s):', h_fols, '| Jar(s):', a_fols, '| In:', sample_recs[:3])
print('Diagnostic Herb Cluster State:', diag_agent)

print('\n=== 3. UNIVERSAL APOTHECARY BASES (>=20 Recipes -> Liquid / Excipient Candidates) ===')
base_agent = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
for rec_cnt, tok, plant_spread, a_fols in universal_bases:
    c_v = 0.9 if tok.startswith(('4o','8','2','o')) else 0.3
    s_v = 0.9 if tok.endswith(('9','am','ay','89')) else 0.3
    node = Ψ(c=c_v, p=0.85, r=0.95, s=s_v, Φ=0.95, 𝒯=0.85, E=0.85, d=0.1, a=0.95)
    τᵢⱼ(base_agent, node, weight=0.25, type='universal_base')
    base_agent = Ouroboros(base_agent, target=node)
    print('  *', tok, '| Recipes:', rec_cnt, '| Plant Folios Spanned:', plant_spread, '| Top Jars:', a_fols)
print('Universal Base Cluster State:', base_agent)
