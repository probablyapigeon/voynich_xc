botanical_agent = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)

print('=== VOYNICH DIAGNOSTIC HERB PHARMACEUTICAL PROFILES (FOR BOTANICAL ID) ===')
for tok, desc, cnt, h_locs, j_locs, bases, acts, recs in profiles:
    c_v = 0.9 if tok.startswith(('4o','8','2','o')) else 0.3
    s_v = 0.9 if tok.endswith(('9','am','ay','89')) else 0.3
    node = Ψ(c=c_v, p=0.35, r=0.90, s=s_v, Φ=0.92, 𝒯=0.85, E=0.82, d=0.1, a=0.92)
    τᵢⱼ(botanical_agent, node, weight=0.25, type='herb_profile')
    botanical_agent = Ouroboros(botanical_agent, target=node)
    print(f'TOKEN: {tok} -> {desc} ({cnt} recipes)')
    print('   Herbal Loci:', h_locs, '| Jar Loci:', j_locs)
    print('   Preferred Base Media:', bases, '| Actions:', acts)
    print('   Recipe Cards:', recs)

print('\nBotanical Profile Cluster State:', botanical_agent)
