profiles = [('okC89', 'Folio 41v (Diagnostic Herb A)', 27, ['41v.5'], ['95r2.2'], [('4ohC9', 9), ('1c79', 8), ('2c89', 7), ('okay', 7)], [('1c89', 10), ('1c9', 9), ('4ohan', 5)], ['Card#9(103r.23)', 'Card#14(103r.42)', 'Card#24(103v.16)', 'Card#34(104r.3)', 'Card#58(104v.35)', 'Card#61(104v.41)', 'Card#74(105v.3)', 'Card#81(105v.22)']), ('okaz', 'Folio 58v (Diagnostic Herb B - Raw)', 18, ['58v.37'], ['89v2.labels_middle[LABEL]'], [('okam', 8), ('okay', 7), ('4oham', 4), ('okae', 4)], [('1c89', 9), ('1c9', 4), ('4ohan', 2)], ['Card#48(104v.1)', 'Card#56(104v.27)', 'Card#72(105r.36)', 'Card#75(105v.6)', 'Card#80(105v.20)', 'Card#82(105v.29)', 'Card#84(105v.35)', 'Card#86(106r.4)']), ('4ohaz', 'Folio 58v (Diagnostic Herb B - Prepared)', 11, ['58v.11', '58v.25', '58v.26', '58v.6'], ['89r1.10', '94r.3'], [('4ohan', 3), ('4oham', 3), ('4ohC9', 2), ('okay', 2)], [('1c89', 3), ('4ohan', 3), ('4ohc89', 2)], ['Card#36(104r.10)', 'Card#56(104v.27)', 'Card#71(105r.34)', 'Card#132(107v.1)', 'Card#135(107v.7)', 'Card#136(107v.11)', 'Card#205(111v.1)', 'Card#282(113v.33)']), ('ayae', 'Folio 58v (Diagnostic Herb B - Variant)', 9, ['58v.18'], ['102r1.12', '87v.13[LABEL]', '90r2.4[LABEL]', '94v.6'], [('1c79', 3), ('ohae', 2), ('1coe', 2), ('oham', 2)], [('1c89', 3), ('4ohc7', 1), ('4ohc89', 1)], ['Card#65(105r.13)', 'Card#166(108v.7)', 'Card#235(112r.39)', 'Card#267(113r.42)', 'Card#280(113v.29)', 'Card#281(113v.31)', 'Card#305(114v.21)', 'Card#322(115r.35)']), ('1o89', 'Folio 1v/2v (Opening Herbal Specimen)', 16, ['1v.10', '1v.2', '1v.7', '1v.8[LABEL]', '2v.3[LABEL]'], ['87r.13[LABEL]', '88r.14', '88v.11', '88v.4', '89v2.3'], [('okae', 5), ('4oham', 5), ('ohae', 4), ('4ohC9', 3)], [('1c89', 7), ('1c9', 4), ('4ohcc9', 2)], ['Card#38(104r.14)', 'Card#56(104v.27)', 'Card#94(106r.32)', 'Card#103(106v.9)', 'Card#122(107r.24)', 'Card#132(107v.1)', 'Card#147(107v.45)', 'Card#228(112r.18)']), ('2o89', 'Folio 1r/4v (Opening Herbal Specimen)', 10, ['1r.23', '1r.7', '1r.8[LABEL]', '4v.11', '4v