print('=== 1. ZERO-GAP (X X) VS BRIDGED (X + CONNECTOR + X) BY SECTION ===')
for sec, zg_tot, br_tot, conns, top_zg, z_obs, b_obs in summary_rows:
    agent_z = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
    for c_val, s_val, e_val in z_obs:
        tok = Ψ(c=c_val, p=0.5, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)
        τᵢⱼ(agent_z, tok, weight=0.3, type='zg_sec')
        agent_z = Ouroboros(agent_z, target=tok)

    agent_b = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
    for c_val, s_val, e_val in b_obs:
        tok = Ψ(c=c_val, p=0.5, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)
        τᵢⱼ(agent_b, tok, weight=0.3, type='br_sec')
        agent_b = Ouroboros(agent_b, target=tok)

    print('\nSECTION:', sec, '| Zero-Gap (X X):', zg_tot, '| Bridged (X + mid + X):', br_tot)
    print('  Connectors:', conns)
    print('  Top Zero-Gap:', top_zg)
    print('  Zero-Gap State:', agent_z)
    print('  Bridged State :', agent_b)

print('\n=== 2. ALL BRIDGED TRIPLES IN HERBAL (1r-66v) ===')
for triple, mid, folio, line_txt in herbal_br:
    print(folio, '|', triple, '| Connector:', mid)
    print('   Line:', line_txt)

print('\n=== 3. ALL BRIDGED TRIPLES IN BATHING (75r-84v) ===')
for triple, mid, folio, line_txt in bathing_br:
    print(folio, '|', triple, '| Connector:', mid)
    print('   Line:', line_txt)
