wrap_agent       = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
line_reset_agent = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
baseline         = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)

for is_new_line, c_val, s_val, e_val in stream:
    tok = Ψ(c=c_val, p=0.9 if is_new_line else 0.2, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)
    
    # Agent 1: Continuous prose wrap across lines
    τᵢⱼ(wrap_agent, tok, weight=0.3, type='wrap')
    wrap_agent = Ouroboros(wrap_agent, target=tok)
    
    # Agent 2: Resets state at every physical parchment line break
    if is_new_line == 1:
        line_reset_agent = Ouroboros(line_reset_agent, target=baseline)
    τᵢⱼ(line_reset_agent, tok, weight=0.3, type='line_reset')
    line_reset_agent = Ouroboros(line_reset_agent, target=tok)

print('1. Continuous Wrap Agent (Prose Model):')
print(wrap_agent)
print('2. Line-Break Reset Agent (Line-Block Model):')
print(line_reset_agent)
