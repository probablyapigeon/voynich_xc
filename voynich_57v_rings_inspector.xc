print('=== 1. FOLIO 57v COMPLETE RING-BY-RING TRANSCRIPTION ===')
page_agent = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
for tag, tcnt, txt, obs in f57v_lines:
    ring_agent = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
    for c_val, s_val, e_val in obs:
        tok = Ψ(c=c_val, p=0.5, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)
        τᵢⱼ(ring_agent, tok, weight=0.3, type='f57v_ring')
        ring_agent = Ouroboros(ring_agent, target=tok)
        τᵢⱼ(page_agent, tok, weight=0.3, type='f57v_page')
        page_agent = Ouroboros(page_agent, target=tok)
    print(tag, '| Tokens:', tcnt)
    print('   Text :', txt)
    print('   State:', ring_agent)

print('\n=== 2. PAGE-LEVEL XEMBRA STATE & 4-QUADRANT KEY CYCLE (57v.2nd_ring) ===')
print('57v Page State:', page_agent)
q_idx = 1
for q in quadrants:
    print('Quadrant', q_idx, ':', q)
    q_idx = q_idx + 1

print('\n=== 3. MULTI-CHAR WORDS ON 57v CROSS-REFERENCED TO 58v, 66r, AND STARRED RECIPES ===')
