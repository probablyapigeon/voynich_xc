    print('  [1. OPENER]:', slots.get('1_opener'))
    print('  [2. VERIFIED 3-WAY INGREDIENTS]:')
    for ing in slots.get('2_verified_3way_ingredients', []):
        print('     -', ing.get('token'), '| State:', ing.get('state'), '| Herbal:', ing.get('herbal_folios'), '| Apoth:', ing.get('apothecary_folios'))
    print('  [3. PROCEDURAL ACTIONS]:', slots.get('3_procedural_actions'))
    print('  [4. CLOSERS]:', slots.get('4_closers'))

    agent = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
    for w, c_val, s_val, e_val in c['obs']:
        tok = Ψ(c=c_val, p=0.5, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)
        τᵢⱼ(agent, tok, weight=0.3, type='cluster_card_flow')
        agent = Ouroboros(agent, target=tok)
    print('  [LIVE XEMBRA FLOW STATE]:', agent)
