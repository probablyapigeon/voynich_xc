print('=== 1. REDUPLICATION DENSITY ACROSS SECTIONS (len >= 3) ===')
for sec, (dbl, tot) in sec_stats.items():
    rate = (dbl * 1000) / tot if tot else 0.0
    print(sec, '| Doubled Pairs:', dbl, '| Total Adjacent Pairs:', tot, '| Rate per 1k:', rate)

print('\n=== 2. ALL SELF-DOUBLED WORDS IN STARRED RECIPES (103r-116v) ===')
for pair, cnt in top_doubles:
    print('DOUBLED:', pair, '| Count:', cnt)

print('\n=== 3. EXACT FOLIO LINES FOR DOUBLED WORDS (103r-116v) ===')
for pair, folio, line_txt, obs in double_contexts:
    agent = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
    for c_val, s_val, e_val in obs:
        tok = Ψ(c=c_val, p=0.5, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)
        τᵢⱼ(agent, tok, weight=0.3, type='reduplication_line')
        agent = Ouroboros(agent, target=tok)
    print(folio, '|', pair, '| State:', agent)
    print('   Line:', line_txt)

print('\n=== 4. TOP 20 FULL-WORD 3-WORD RECIPE FORMULAS (103r-116v, len >= 3) ===')
for phrase, cnt, obs in top_trigrams:
    agent = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
    for c_val, s_val, e_val in obs:
        tok = Ψ(c=c_val, p=0.5, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)
        τᵢⱼ(agent, tok, weight=0.3, type='clean_trigram')
        agent = Ouroboros(agent, target=tok)
    print('3-WORD:', phrase, '| Count:', cnt, '|', agent)
