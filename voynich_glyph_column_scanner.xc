print('=== 1. EXPLICIT COLUMN / MARGIN / GLYPH TAGS ACROSS MANUSCRIPT ===')
c1 = 0
for _ in tag_hits:
    c1 = c1 + 1
print('Total Explicit Column/Margin Tags Found:', c1)
for tag, tcnt, srat, ovlp, txt, obs in tag_hits:
    agent = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
    for c_val, s_val, e_val in obs:
        tok = Ψ(c=c_val, p=0.5, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)
        τᵢⱼ(agent, tok, weight=0.3, type='glyph_col_tag')
        agent = Ouroboros(agent, target=tok)
    print(tag, '| Tokens:', tcnt, '| 1-Char Ratio:', srat, '| 66r Symbol Overlap:', ovlp)
    print('   Text:', txt)
    print('   State:', agent)

print('\n=== 2. ALL LINES WITH >= 6 TOKENS AND >= 70% SINGLE-CHARACTER GLYPHS ===')
c2 = 0
for _ in single_char_lines:
    c2 = c2 + 1
print('Total High-Density Single-Char Lines:', c2)
for tag, tcnt, srat, ovlp, txt, obs in single_char_lines:
    agent = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
    for c_val, s_val, e_val in obs:
        tok = Ψ(c=c_val, p=0.5, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)
        τᵢⱼ(agent, tok, weight=0.3, type='single_char_line')
        agent = Ouroboros(agent, target=tok)
    print(tag, '| Tokens:', tcnt, '| 1-Char Ratio:', srat, '| 66r Symbol Overlap:', ovlp)
    print('   Text:', txt)
    print('   State:', agent)
