def evolve_sample(obs_list, label):
    agent = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
    for c_val, s_val, e_val in obs_list:
        tok = Ψ(c=c_val, p=0.5, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)
        τᵢⱼ(agent, tok, weight=0.3, type=label)
        agent = Ouroboros(agent, target=tok)
    return agent

print('=== 1. OBSERVED PHARMA JAR OVERLAP (N =', n_jars, 'UNIQUE JAR TOKENS) ===')
print('Observed Jar -> Starred Recipe Matches         :', obs_rec_hits, '(', (obs_rec_hits * 10000 // n_jars) / 100.0, '% )')
print('Observed 3-Way Codex Bridges (Herbal+Jar+Rec)  :', obs_tri_hits, '(', (obs_tri_hits * 10000 // n_jars) / 100.0, '% )')

print('\n=== 2. MODEL A: UNIFORM VOCABULARY NULL BASELINE (1,000 PERMUTATIONS) ===')
print('Jar -> Recipe Null (Mean, SD, Z-score, p-val)  :', u_rec_stats)
print('3-Way Bridge Null  (Mean, SD, Z-score, p-val)  :', u_tri_stats)

print('\n=== 3. MODEL B: ZIPFIAN FREQUENCY-WEIGHTED NULL BASELINE (1,000 PERMUTATIONS) ===')
print('Jar -> Recipe Null (Mean, SD, Z-score, p-val)  :', f_rec_stats)
print('3-Way Bridge Null  (Mean, SD, Z-score, p-val)  :', f_tri_stats)

print('\n=== 4. XEMBRA STATE SEPARATION: REAL PHARMA JARS VS ZIPFIAN NULL SAMPLE ===')
print('Real Pharma Jar Vocabulary (238 tokens)        :', evolve_sample(jar_obs, 'real_jars'))
print('Zipfian Null Vocabulary Sample (238 tokens)    :', evolve_sample(null_obs, 'null_sample'))
