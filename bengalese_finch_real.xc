print('Loaded real Bengalese finch bouts:', 40, '| Total syllables:', 469)

baseline = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
continuous_finch = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
breath_reset_finch = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)

for bout in bouts:
    breath_reset_finch = Ouroboros(breath_reset_finch, target=baseline)
    for is_first, c_val, s_val, e_val in bout:
        p_val = 0.9 if is_first == 1 else 0.2
        tok = Ψ(c=c_val, p=p_val, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)

        τᵢⱼ(continuous_finch, tok, weight=0.30, type='continuous_finch')
        continuous_finch = Ouroboros(continuous_finch, target=tok)

        τᵢⱼ(breath_reset_finch, tok, weight=0.30, type='breath_reset_finch')
        breath_reset_finch = Ouroboros(breath_reset_finch, target=tok)

shuffled_finch = Ψ(c=0.5, p=0.5, r=0.5, s=0.5, Φ=0.5, 𝒯=0.5, E=0.5, d=0.5, a=0.5)
for c_val, s_val, e_val in shuffled:
    tok = Ψ(c=c_val, p=0.5, r=e_val, s=s_val, Φ=0.6, 𝒯=0.4, E=e_val, d=0.3, a=0.5)
    τᵢⱼ(shuffled_finch, tok, weight=0.30, type='shuffled_finch')
    shuffled_finch = Ouroboros(shuffled_finch, target=tok)

print('=== REAL BENGALESE FINCH SYNTAX PROBE RESULTS ===')
print('1. Continuous Song (Cross-Breath Memory) :', continuous_finch)
print('2. Breath-Reset Song (Bout-Locked)       :', breath_reset_finch)
print('3. Shuffled Control (Scrambled Syllables):', shuffled_finch)
